
1.A. GENERATION OF CONTINUOUS TIME SIGNALS:
  
clc;
clear;
close all;
% Define parameters
f = 5;           % Frequency in Hz
A = 2;           % Amplitude
phi = pi/4;      % Phase shift in radians
% Generate time vector
t = 0:0.001:1;
% Generate sinusoidal signal
x_t = A * sin(2 * pi * f * t + phi);
% Plot the signal
figure;
plot(t, x_t, 'b', 'LineWidth', 1.5);
grid on;
xlabel('Time (s)');
ylabel('Amplitude');
title('CONTINUOUS TIME SIGNALS: 5 Hz, Amplitude 2, Phase Shift pi/4');


1.B. GENERATION OF DISCRETE TIME SIGNALS

clc;
clear;
close all;

N = 21;
n0 = 11;
n = 1:N;
x = zeros(1,N);
x(n0) = 1;

plot(n,x,'k-');
hold on;
stem(n,x,'k','filled');
grid on;
xlim([0 22]);
ylim([0 1]);
xticks(0:2:22);
xlabel('n (Discrete Time Index)');
ylabel('Amplitude');
title('Discrete-Time Unit Impulse Signal');

