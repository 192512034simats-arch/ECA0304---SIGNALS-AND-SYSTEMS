2. PERIODIC AND APERIODIC SIGNALS

clc;
clear;
close all;
% Periodic signal parameters
f_periodic = 1;
A_periodic = 1;
t = 0:0.01:2;
x_periodic = A_periodic*sin(2*pi*f_periodic*t);
subplot(2,1,1);
plot(t,x_periodic,'b','LineWidth',1.5);
grid on;
xlim([0 2]);
ylim([-1.2 1.2]);
xlabel('Time (s)');
ylabel('Amplitude');
title('Periodic Signal: Sinusoidal Wave (1 Hz)');
% Aperiodic signal parameters
a_aperiodic = 0.5;
A_aperiodic = 2;
x_aperiodic = A_aperiodic*exp(-a_aperiodic*t);
subplot(2,1,2);
plot(t,x_aperiodic,'r','LineWidth',1.5);
grid on;
xlim([0 2]);
ylim([0 2.2]);
xlabel('Time (s)');
ylabel('Amplitude');
title('Aperiodic Signal: Exponentially Decaying Signal');


